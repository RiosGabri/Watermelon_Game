	$(MAKE) $(MAKESILENT) -f CMakeFiles/Watermelon_Game.dir/build.make CMakeFiles/Watermelon_Game.dir/src/menu.c.i
.PHONY : src/menu.c.i

src/menu.s: src/menu.c.s
.PHONY : src/menu.s

# target to generate assembly for a file
src/menu.c.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Watermelon_Game.dir/build.make CMakeFiles/Watermelon_Game.dir/src/menu.c.s
.PHONY : src/menu.c.s

src/physics.o: src/physics.c.o
.PHONY : src/physics.o

